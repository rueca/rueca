    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync.mjs",
    "qa": "node scripts/qa.mjs",
    "check": "node scripts/sync.mjs --check && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
