{
  "name": "prototype-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5273 --strictPort",
    "build": "node scripts/sync.mjs && tsc --noEmit && vite build",
