{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@kit": ["./src/kit/index.ts"], "@kit/*": ["./src/kit/*"], "@/*": ["./src/*"] }
  },
  "include": ["src", "tests"],
  // checked by tsconfig.notes-server.json instead: it imports with .ts extensions, as a nodenext config needs
  "exclude": ["src/kit/notes-server/vite.ts"]
}
